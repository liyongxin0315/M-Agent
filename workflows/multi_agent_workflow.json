{
  "workflow_name": "多 Agent 协作工作流",
  "version": "1.0.0",
  "description": "多 Agent 协作工作流模板，支持规划者 - 执行者 - 审核者模式、并行执行模式和专家会诊模式",
  "author": "AgentM",
  "created_at": "2026-04-01",
  
  "coordinator_config": {
    "message_queue_size": 10000,
    "task_timeout_seconds": 300,
    "heartbeat_interval_seconds": 30,
    "max_retries": 3,
    "conflict_resolution": "priority_based"
  },
  
  "agent_roles": {
    "planner": {
      "description": "规划者 - 负责任务拆解和规划",
      "capabilities": ["task_decomposition", "planning", "dependency_analysis"],
      "max_concurrent_tasks": 1,
      "priority": 5
    },
    "executor": {
      "description": "执行者 - 负责执行具体任务",
      "capabilities": ["execution", "implementation", "problem_solving"],
      "max_concurrent_tasks": 3,
      "priority": 3
    },
    "reviewer": {
      "description": "审核者 - 负责质量审核",
      "capabilities": ["review", "quality_check", "validation"],
      "max_concurrent_tasks": 2,
      "priority": 4
    },
    "coordinator": {
      "description": "协调者 - 负责总体协调",
      "capabilities": ["coordination", "communication", "conflict_resolution"],
      "max_concurrent_tasks": 1,
      "priority": 5
    },
    "specialist": {
      "description": "专家 - 特定领域专家",
      "capabilities": ["domain_expertise", "consultation", "decision_support"],
      "max_concurrent_tasks": 1,
      "priority": 4
    }
  },
  
  "workflow_templates": {
    "planner_executor_reviewer": {
      "name": "规划者 - 执行者 - 审核者工作流",
      "description": "经典的三段式协作模式",
      "phases": [
        {
          "phase_id": "planning",
          "name": "规划阶段",
          "agent_role": "planner",
          "tasks": [
            {
              "task_id": "decompose_goal",
              "name": "目标拆解",
              "description": "将复杂目标拆解为可执行的子任务",
              "expected_output": "任务列表和依赖关系"
            },
            {
              "task_id": "create_plan",
              "name": "创建执行计划",
              "description": "制定详细的执行计划和时间表",
              "expected_output": "执行计划"
            }
          ],
          "exit_condition": "所有规划任务完成"
        },
        {
          "phase_id": "execution",
          "name": "执行阶段",
          "agent_role": "executor",
          "parallel": true,
          "tasks": [
            {
              "task_id": "execute_subtask",
              "name": "执行子任务",
              "description": "根据计划执行各个子任务",
              "expected_output": "任务结果",
              "instance_per_subtask": true
            }
          ],
          "exit_condition": "所有子任务完成"
        },
        {
          "phase_id": "review",
          "name": "审核阶段",
          "agent_role": "reviewer",
          "tasks": [
            {
              "task_id": "quality_check",
              "name": "质量检查",
              "description": "检查执行结果的质量",
              "expected_output": "审核报告"
            },
            {
              "task_id": "validation",
              "name": "验证",
              "description": "验证结果是否符合目标",
              "expected_output": "验证结论"
            }
          ],
          "exit_condition": "审核通过或需要返工"
        }
      ],
      "communication_protocol": {
        "planner_to_executor": {
          "message_type": "task_assign",
          "content_format": {
            "task_id": "string",
            "description": "string",
            "requirements": "array",
            "deadline": "timestamp"
          }
        },
        "executor_to_reviewer": {
          "message_type": "task_complete",
          "content_format": {
            "task_id": "string",
            "result": "object",
            "self_assessment": "string"
          }
        },
        "reviewer_feedback": {
          "message_type": "review_result",
          "content_format": {
            "task_id": "string",
            "passed": "boolean",
            "feedback": "string",
            "suggestions": "array"
          }
        }
      }
    },
    
    "parallel_execution": {
      "name": "并行执行工作流",
      "description": "多个执行者并行执行独立任务",
      "phases": [
        {
          "phase_id": "setup",
          "name": "准备阶段",
          "agent_role": "coordinator",
          "tasks": [
            {
              "task_id": "analyze_dependencies",
              "name": "分析依赖",
              "description": "分析任务间的依赖关系",
              "expected_output": "依赖图"
            },
            {
              "task_id": "assign_agents",
              "name": "分配 Agent",
              "description": "为每个独立任务分配执行者",
              "expected_output": "分配方案"
            }
          ]
        },
        {
          "phase_id": "parallel_exec",
          "name": "并行执行",
          "agent_role": "executor",
          "parallel": true,
          "tasks": [
            {
              "task_id": "independent_task",
              "name": "独立任务",
              "description": "执行独立任务",
              "expected_output": "任务结果",
              "sync_points": ["phase_end"]
            }
          ],
          "exit_condition": "所有并行任务完成"
        },
        {
          "phase_id": "merge",
          "name": "合并阶段",
          "agent_role": "coordinator",
          "tasks": [
            {
              "task_id": "merge_results",
              "name": "合并结果",
              "description": "合并所有并行任务的结果",
              "expected_output": "合并结果"
            }
          ]
        }
      ],
      "synchronization": {
        "type": "barrier",
        "timeout_seconds": 600,
        "on_timeout": "continue_with_partial"
      }
    },
    
    "expert_consultation": {
      "name": "专家会诊工作流",
      "description": "多个专家共同解决复杂问题",
      "phases": [
        {
          "phase_id": "problem_statement",
          "name": "问题陈述",
          "agent_role": "coordinator",
          "tasks": [
            {
              "task_id": "define_problem",
              "name": "定义问题",
              "description": "清晰定义需要解决的问题",
              "expected_output": "问题描述"
            }
          ]
        },
        {
          "phase_id": "expert_analysis",
          "name": "专家分析",
          "agent_role": "specialist",
          "parallel": true,
          "tasks": [
            {
              "task_id": "domain_analysis",
              "name": "领域分析",
              "description": "从各自专业角度分析问题",
              "expected_output": "分析报告",
              "specialization_required": true
            }
          ]
        },
        {
          "phase_id": "discussion",
          "name": "讨论阶段",
          "agent_role": "all",
          "rounds": 3,
          "tasks": [
            {
              "task_id": "cross_review",
              "name": "交叉评审",
              "description": "专家们互相评审对方的分析",
              "expected_output": "评审意见"
            },
            {
              "task_id": "consensus_building",
              "name": "建立共识",
              "description": "寻求共识点",
              "expected_output": "共识列表"
            }
          ]
        },
        {
          "phase_id": "synthesis",
          "name": "综合阶段",
          "agent_role": "coordinator",
          "tasks": [
            {
              "task_id": "synthesize_solution",
              "name": "综合方案",
              "description": "综合各方意见形成最终方案",
              "expected_output": "最终方案"
            }
          ]
        }
      ],
      "consensus_mechanism": {
        "type": "weighted_vote",
        "quorum": 0.67,
        "tie_breaker": "coordinator"
      }
    }
  },
  
  "message_types": {
    "task_assign": {
      "description": "任务分配消息",
      "fields": {
        "task_id": "任务 ID",
        "task_name": "任务名称",
        "description": "任务描述",
        "requirements": "要求列表",
        "deadline": "截止时间",
        "priority": "优先级"
      }
    },
    "task_complete": {
      "description": "任务完成消息",
      "fields": {
        "task_id": "任务 ID",
        "result": "执行结果",
        "duration": "执行时长",
        "self_assessment": "自我评估"
      }
    },
    "task_failed": {
      "description": "任务失败消息",
      "fields": {
        "task_id": "任务 ID",
        "error": "错误信息",
        "retry_possible": "是否可重试",
        "suggestions": "建议"
      }
    },
    "request_help": {
      "description": "请求帮助消息",
      "fields": {
        "task_id": "任务 ID",
        "help_type": "帮助类型",
        "description": "需要帮助的内容",
        "urgency": "紧急程度"
      }
    },
    "provide_help": {
      "description": "提供帮助消息",
      "fields": {
        "task_id": "任务 ID",
        "helper_id": "帮助者 ID",
        "help_content": "帮助内容"
      }
    },
    "status_update": {
      "description": "状态更新消息",
      "fields": {
        "agent_id": "Agent ID",
        "status": "状态",
        "current_task": "当前任务",
        "progress": "进度百分比"
      }
    },
    "sync_request": {
      "description": "同步请求消息",
      "fields": {
        "sync_point": "同步点",
        "agent_id": "Agent ID",
        "ready": "是否就绪"
      }
    },
    "sync_response": {
      "description": "同步响应消息",
      "fields": {
        "sync_point": "同步点",
        "all_ready": "是否全部就绪",
        "waiting_for": "等待的 Agent 列表"
      }
    }
  },
  
  "conflict_resolution": {
    "strategies": {
      "priority_based": {
        "description": "基于优先级解决冲突",
        "rules": [
          "高优先级任务优先",
          "相同优先级时，先到的任务优先",
          "紧急任务可抢占资源"
        ]
      },
      "vote_based": {
        "description": "基于投票解决冲突",
        "rules": [
          "所有相关 Agent 投票",
          "简单多数决",
          "平局时协调者决定"
        ]
      },
      "negotiation": {
        "description": "基于协商解决冲突",
        "rules": [
          "冲突方进行协商",
          "寻求共赢方案",
          "协商失败升级至协调者"
        ]
      }
    }
  },
  
  "example_usage": {
    "scenario": "开发一个新功能",
    "workflow": "planner_executor_reviewer",
    "input": {
      "goal": "开发用户登录功能",
      "agents": [
        {"id": "planner-1", "role": "planner"},
        {"id": "executor-1", "role": "executor", "specialty": "backend"},
        {"id": "executor-2", "role": "executor", "specialty": "frontend"},
        {"id": "reviewer-1", "role": "reviewer"}
      ]
    },
    "expected_flow": [
      "planner-1 拆解任务：['设计 API', '实现后端', '实现前端', '编写测试']",
      "executor-1 实现后端",
      "executor-2 实现前端",
      "reviewer-1 审核代码质量",
      "完成"
    ]
  },
  
  "metrics": {
    "collaboration_efficiency": "协作效率（任务完成时间/预估时间）",
    "task_success_rate": "任务成功率",
    "communication_overhead": "通信开销（消息数/任务数）",
    "conflict_rate": "冲突发生率",
    "agent_utilization": "Agent 利用率"
  }
}
