# Tavily 客户端（从环境变量读取 API Key）
_tavily_client = None

def get_tavily_client():
    global _tavily_client
    if _tavily_client is None:
        api_key = os.getenv('TAVILY_API_KEY', 'tvly-xxxxx')
        _tavily_client = TavilyClient(api_key=api_key)
    return _tavily_client


def tavily_search(query: str, max_results: int = 5, auto_store: bool = True) -> dict:
    """Tavily 网络搜索 + 自动存储到记忆"""
    import logging
    logger = logging.getLogger(__name__)
    
    logger.info(f"[Tavily] 开始搜索：query={query}, max_results={max_results}, auto_store={auto_store}")
    
    try:
        client = get_tavily_client()
        logger.info("[Tavily] 客户端已创建")
        
        response = client.search(query, max_results=max_results)
        logger.info(f"[Tavily] 搜索完成，找到 {len(response.get('results', []))} 条结果")
        
        results = []
        stored_count = 0
        
        # 处理搜索结果
        for r in response.get("results", []):
            result = {
                "title": r.get("title"),
                "url": r.get("url"),
                "content": r.get("content")
            }
            results.append(result)
            
            # 自动存储到记忆
            if auto_store:
                try:
                    from ..memory import MemoryManager
                    # OwnerConfig not needed, use MemoryManager
                    config = OwnerConfig()
                    storage = StorageAdapter(config)
                    memory.add_memory(
                        content=f"{r.get('title', 'No title')}: {r.get('content', 'No content')}",
                        memory_type="semantic",
                        metadata={
                            "source": "tavily_search",
                            "url": r.get("url", ""),
                            "query": query
                        },
                        confidence=0.7
                    )
                    stored_count += 1
                    logger.info(f"[Tavily] 已存储记忆：{stored_count}")
                except Exception as e:
                    logger.error(f"[Tavily] 存储失败：{e}")
        
        logger.info(f"[Tavily] 返回结果：{len(results)} 条，存储 {stored_count} 条")
        
        return {
            "status": "success",
            "query": query,
            "results": results,
            "stored_count": stored_count
        }
    except Exception as e:
        logger.error(f"[Tavily] 搜索失败：{e}")
        return {"status": "error", "error": str(e)}


def tavily_fetch(url: str) -> dict:
    """Tavily 网页内容提取"""
    try:
        client = get_tavily_client()
        response = client.get_search_context([url])
        return {
            "status": "success",
            "url": url,
            "content": response
        }
    except Exception as e:
        return {"status": "error", "error": str(e)}


