@app.post("/api/v1/memories", response_model=MemoryResponse)
async def create_memory(
    memory: MemoryCreate,
    api_key: str = Depends(verify_api_key)
):
    """创建新记忆"""
    try:
        memory_type = MemoryType(memory.memory_type)
    except ValueError:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Invalid memory type: {memory.memory_type}"
        )
    
    created = _memory.add_memory(
        content=memory.content,
        metadata=memory.metadata,
        memory_type=memory_type,
        confidence=memory.confidence
    )
    
    return MemoryResponse(
        memory_id=created.memory_id,
        content=created.content,
        memory_type=created.memory_type.value,
        metadata=created.metadata,
        confidence=created.confidence,
        created_at=created.created_at,
        access_count=created.access_count
    )


@app.post("/api/v1/memories/search", response_model=List[MemoryResponse])
async def search_memories(
    request: MemorySearchRequest,
    api_key: str = Depends(verify_api_key)
):
    """搜索记忆"""
    try:
        memory_type = MemoryType(request.memory_type) if request.memory_type else None
    except ValueError:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Invalid memory type: {request.memory_type}"
        )
    
    results = _memory_store.search_memories(
        query=request.query,
        limit=request.limit,
        memory_type=memory_type,
        min_confidence=request.min_confidence
    )
    
    return [
        MemoryResponse(
            memory_id=r.memory.memory_id,
            content=r.memory.content,
            memory_type=r.memory.memory_type.value,
            metadata=r.memory.metadata,
            confidence=r.memory.confidence,
            created_at=r.memory.created_at,
            access_count=r.memory.access_count
        )
        for r in results
    ]


