@app.get("/api/v1/events", response_model=List[EventResponse])
async def get_events(
    limit: int = 100,
    api_key: str = Depends(verify_api_key)
):
    """获取历史事件"""
    events = await _event_bus.load_events(limit=limit)
    
    return [
        EventResponse(
            event_id=e.event_id,
            event_type=e.event_type,
            data=e.data,
            timestamp=e.timestamp,
            source=e.source
        )
        for e in events
    ]


@app.websocket("/ws/events")
async def websocket_events(websocket: WebSocket):
    """WebSocket 事件推送"""
    await websocket.accept()
    _websocket_clients.add(websocket)
    
    try:
        while True:
            # 保持连接
            data = await websocket.receive_text()
            
            # 可以处理客户端消息
            if data == "ping":
                await websocket.send_text("pong")
                
    except WebSocketDisconnect:
        pass
    finally:
        _websocket_clients.remove(websocket)


async def broadcast_event(event: Event):
    """广播事件到 WebSocket 客户端"""
    if not _websocket_clients:
        return
    
    message = {
        "event_id": event.event_id,
        "event_type": event.event_type,
        "data": event.data,
        "timestamp": event.timestamp,
        "source": event.source
    }
    
    disconnected = set()
    for client in _websocket_clients:
        try:
            await client.send_json(message)
        except Exception:
            disconnected.add(client)
    
    # 移除断开的客户端
    _websocket_clients.difference_update(disconnected)


# ==================== Main ====================

def main():
    """API 服务器入口"""
    import argparse
    
    parser = argparse.ArgumentParser(description="AgentM Core API Server")
    parser.add_argument("--host", default="127.0.0.1", help="Host to bind")
    parser.add_argument("--port", type=int, default=8765, help="Port to bind")
    parser.add_argument("--reload", action="store_true", help="Enable auto-reload")
    
    args = parser.parse_args()
    
    # 加载配置
    config_path = Path(__file__).parent.parent / "config.yaml"
    config = {}
    if config_path.exists():
        with open(config_path, 'r') as f:
            config = yaml.safe_load(f)
    
    host = args.host or config.get('server', {}).get('host', '127.0.0.1')
    port = args.port or config.get('server', {}).get('port', 8765)
    
    logging.basicConfig(
        level=logging.INFO,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )
    
    logging.info(f"Starting API server on {host}:{port}")
    
    uvicorn.run(
        "api_server:app",
        host=host,
        port=port,
        reload=args.reload,
        log_level="info"
    )


if __name__ == "__main__":
    main()
