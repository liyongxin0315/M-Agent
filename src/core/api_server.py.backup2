@app.put("/api/v1/memories/{memory_id}/confidence")
async def update_memory_confidence(
    memory_id: str,
    confidence: float,
    api_key: str = Depends(verify_api_key)
):
    """更新记忆置信度"""
    if not 0.0 <= confidence <= 1.0:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Confidence must be between 0.0 and 1.0"
        )
    
    if not _memory_store.update_confidence(memory_id, confidence):
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Memory not found: {memory_id}"
        )
    
    return {"message": f"Memory confidence updated: {memory_id}"}


@app.delete("/api/v1/memories/{memory_id}")
async def delete_memory(memory_id: str, api_key: str = Depends(verify_api_key)):
    """删除记忆"""
    if not _memory_store.delete_memory(memory_id):
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Memory not found: {memory_id}"
        )
    return {"message": f"Memory deleted: {memory_id}"}


@app.post("/api/v1/tasks", response_model=TaskResponse)
async def create_task(
    task: TaskCreate,
    api_key: str = Depends(verify_api_key)
):
    """创建新任务"""
    try:
        priority = TaskPriority[task.priority.upper()]
    except KeyError:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=f"Invalid priority: {task.priority}"
        )
    
    created = _scheduler.schedule(
        handler=task.handler,
        args=tuple(task.args) if task.args else (),
        kwargs=task.kwargs,
        delay_seconds=task.delay_seconds,
        cron_expr=task.cron_expr,
        priority=priority
    )
    
    return TaskResponse(
        task_id=created.task_id,
        name=created.name,
        status=created.status.value,
        priority=created.priority.name,
        created_at=created.created_at,
        scheduled_at=created.scheduled_at
    )


@app.get("/api/v1/tasks/{task_id}", response_model=TaskResponse)
async def get_task(task_id: str, api_key: str = Depends(verify_api_key)):
    """获取任务状态"""
    task = _scheduler.get_task(task_id)
    
    if not task:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Task not found: {task_id}"
        )
    
    return TaskResponse(
        task_id=task.task_id,
        name=task.name,
        status=task.status.value,
        priority=task.priority.name,
        created_at=task.created_at,
        scheduled_at=task.scheduled_at,
        result=task.result,
        error=task.error
    )


