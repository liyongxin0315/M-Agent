# ==================== Pydantic Models ====================

class GoalCreate(BaseModel):
    """创建目标请求"""
    description: str = Field(..., min_length=1, max_length=1000)
    priority: int = Field(default=3, ge=1, le=5)
    deadline: Optional[str] = None
    subtasks: Optional[List[Dict[str, Any]]] = None
    metadata: Optional[Dict[str, Any]] = None


class GoalResponse(BaseModel):
    """目标响应"""
    goal_id: str
    description: str
    status: str
    priority: int
    created_at: str
    deadline: Optional[str]
    progress: float
    subtask_count: int
    completed_count: int


class MemoryCreate(BaseModel):
    """创建记忆请求"""
    content: str = Field(..., min_length=1, max_length=10000)
    memory_type: str = Field(default="long_term")
    metadata: Optional[Dict[str, Any]] = None
    confidence: float = Field(default=0.5, ge=0.0, le=1.0)


class MemoryResponse(BaseModel):
    """记忆响应"""
    memory_id: str
    content: str
    memory_type: str
    metadata: Dict[str, Any]
    confidence: float
    created_at: str
    access_count: int


class MemorySearchRequest(BaseModel):
    """记忆搜索请求"""
    query: str = Field(..., min_length=1)
    limit: int = Field(default=10, ge=1, le=100)
    memory_type: Optional[str] = None
    min_confidence: float = Field(default=0.0, ge=0.0, le=1.0)


class TaskCreate(BaseModel):
    """创建任务请求"""
    handler: str
    args: Optional[List[Any]] = None
    kwargs: Optional[Dict[str, Any]] = None
    delay_seconds: Optional[float] = None
    cron_expr: Optional[str] = None
    priority: str = Field(default="normal")


class TaskResponse(BaseModel):
    """任务响应"""
    task_id: str
    name: str
    status: str
    priority: str
    created_at: str
    scheduled_at: str
    result: Optional[Any] = None
    error: Optional[str] = None


class SystemStatus(BaseModel):
    """系统状态响应"""
    status: str
    version: str
    uptime_seconds: float
    active_goals: int
    pending_tasks: int
    running_tasks: int
    memory_count: int
    event_queue_size: int


class EventResponse(BaseModel):
    """事件响应"""
    event_id: str
    event_type: str
    data: Dict[str, Any]
    timestamp: str
    source: str


class TokenRequest(BaseModel):
    """Token 请求"""
    api_key: str


class TokenResponse(BaseModel):
    """Token 响应"""
    access_token: str
    token_type: str = "bearer"
    expires_in: int


# ==================== Authentication ====================

API_KEY_HEADER = APIKeyHeader(name="X-API-Key", auto_error=False)

_api_keys: Set[str] = set()
_access_tokens: Dict[str, datetime] = {}


def init_auth(api_key: str) -> None:
    """初始化认证"""
    _api_keys.add(api_key)


async def verify_api_key(api_key: Optional[str] = Depends(API_KEY_HEADER)) -> str:
    """验证 API Key"""
    if not api_key:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="API Key required"
        )
    if api_key not in _api_keys:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid API Key"
        )
    return api_key


async def verify_token(token: Optional[str] = Depends(APIKeyHeader(name="Authorization", auto_error=False))) -> str:
    """验证访问 Token"""
    if not token:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Token required"
        )
    
    # 移除 Bearer 前缀
    if token.startswith("Bearer "):
        token = token[7:]
    
    if token not in _access_tokens:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or expired token"
        )
    
    # 检查过期
    if datetime.utcnow() > _access_tokens[token]:
        del _access_tokens[token]
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Token expired"
        )
    
    return token


# ==================== Lifespan ====================

_start_time: datetime = None
_event_bus: EventBus = None
_memory_store: MemoryStore = None
_scheduler: TaskScheduler = None
_agent: AutonomousAgent = None
_websocket_clients: Set[WebSocket] = set()


@asynccontextmanager
async def lifespan(app: FastAPI):
    """应用生命周期管理"""
    global _start_time, _event_bus, _memory_store, _scheduler, _agent
    
    # 启动
    _start_time = datetime.utcnow()
    
    # 加载配置
    config_path = Path(__file__).parent.parent / "config.yaml"
    config = {}
    if config_path.exists():
        with open(config_path, 'r') as f:
            config = yaml.safe_load(f)
    
    # 初始化组件
    event_config = config.get('event_bus', {})
    memory_config = config.get('memory', {})
    scheduler_config = config.get('scheduler', {})
    autonomous_config = config.get('autonomous', {})
    security_config = config.get('security', {})
    
    _event_bus = EventBus(
        persistence_path=event_config.get('persistence_path'),
        queue_size=event_config.get('queue_size', 1000)
    )
    
    _memory_store = MemoryStore(
        chromadb_path=memory_config.get('chromadb_path'),
        cache_ttl=memory_config.get('cache_ttl', 3600)
    )
    
    _scheduler = TaskScheduler(
        max_concurrent=scheduler_config.get('max_concurrent', 3)
    )
    
    _agent = AutonomousAgent(
        event_bus=_event_bus,
        memory_store=_memory_store,
        scheduler=_scheduler,
        reflection_interval=autonomous_config.get('reflection_interval', 300)
    )
    
    # 初始化认证
    api_key = security_config.get('api_key', 'agentm-secret-key-change-me')
    init_auth(api_key)
    
    # 注册默认 handler
    _scheduler.register_handler("noop", lambda: None)
    _scheduler.register_handler("print", lambda *args, **kwargs: print(*args, **kwargs))
    _scheduler.register_handler("log", lambda msg: logging.info(f"[Task] {msg}"))
    _scheduler.register_handler("tavily_search", tavily_search)
    _scheduler.register_handler("tavily_fetch", tavily_fetch)
    
    # 启动后台任务
    asyncio.create_task(_event_bus.process_events())
    asyncio.create_task(_scheduler.run_pending())
    asyncio.create_task(_agent.autonomous_loop())
    
    logging.info("AgentM Core API Server started")
    
    yield
    
    # 关闭
    _agent.stop()
    _scheduler.stop()
    _event_bus.stop()
    
    # 关闭 WebSocket 连接
    for client in _websocket_clients:
        await client.close()
    
    logging.info("AgentM Core API Server stopped")


# ==================== FastAPI App ====================

app = FastAPI(
    title="AgentM Core API",
    description="Autonomous Agent Core System API",
    version="1.0.0",
    lifespan=lifespan
)

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # 生产环境应该限制
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ==================== Routes ====================

@app.get("/")
async def root():
    """根路径"""
    return {
        "name": "AgentM Core API",
        "version": "1.0.0",
        "status": "running"
    }


@app.post("/api/v1/auth/token", response_model=TokenResponse)
async def get_token(request: TokenRequest):
    """获取访问 Token"""
    if request.api_key not in _api_keys:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid API Key"
        )
    
    # 生成 Token
    token = secrets.token_urlsafe(32)
    expires_in = 3600  # 1 小时
    
    _access_tokens[token] = datetime.utcnow() + timedelta(seconds=expires_in)
    
    return TokenResponse(
        access_token=token,
        expires_in=expires_in
    )


@app.get("/api/v1/status", response_model=SystemStatus)
async def get_status(api_key: str = Depends(verify_api_key)):
    """获取系统状态"""
    uptime = (datetime.utcnow() - _start_time).total_seconds() if _start_time else 0
    
    return SystemStatus(
        status="running",
        version="1.0.0",
        uptime_seconds=uptime,
        active_goals=len(_agent.get_active_goals()) if _agent else 0,
        pending_tasks=_scheduler.get_pending_count() if _scheduler else 0,
        running_tasks=_scheduler.get_running_count() if _scheduler else 0,
        memory_count=_memory_store.get_statistics()["long_term_count"] if _memory_store else 0,
        event_queue_size=_event_bus.queue_size if _event_bus else 0
    )


@app.post("/api/v1/goals", response_model=GoalResponse)
async def create_goal(
    goal: GoalCreate,
    api_key: str = Depends(verify_api_key)
):
    """创建新目标"""
    try:
        created_goal = _agent.set_goal(
            description=goal.description,
            priority=goal.priority,
            deadline=goal.deadline,
            subtasks=goal.subtasks,
            metadata=goal.metadata
        )
        
        return GoalResponse(
            goal_id=created_goal.goal_id,
            description=created_goal.description,
            status=created_goal.status.value,
            priority=created_goal.priority,
            created_at=created_goal.created_at,
            deadline=created_goal.deadline,
            progress=created_goal.progress(),
            subtask_count=len(created_goal.subtasks),
            completed_count=len(created_goal.completed_tasks)
        )
        
    except ValueError as e:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail=str(e)
        )


@app.get("/api/v1/goals", response_model=List[GoalResponse])
async def list_goals(api_key: str = Depends(verify_api_key)):
    """获取所有活动目标"""
    goals = _agent.get_active_goals()
    
    return [
        GoalResponse(
            goal_id=g.goal_id,
            description=g.description,
            status=g.status.value,
            priority=g.priority,
            created_at=g.created_at,
            deadline=g.deadline,
            progress=g.progress(),
            subtask_count=len(g.subtasks),
            completed_count=len(g.completed_tasks)
        )
        for g in goals
    ]


